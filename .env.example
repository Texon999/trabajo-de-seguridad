# Copia este archivo a .env y ajusta los valores.
# Spring Boot lee estas variables desde el entorno del sistema
# (en Windows: setx MONGO_URI "..."  o configuralas en tu IDE).
#
# Con MongoDB sin autenticacion local:
#   MONGO_URI=mongodb://localhost:27017/tienda_db
#

#   MONGO_URI=mongodb://tienda_user:TuClaveFuerte!@localhost:27017/tienda_db?authSource=tienda_db

MONGO_URI=mongodb://localhost:27017/tienda_db


#   openssl rand -base64 48
# JWT_SECRET: genera una clave larga y aleatoria y defínela en el entorno
# del sistema antes de arrancar. No uses valores cortos ni predecibles.
# Este archivo es solo una plantilla; no incluye valor real de JWT_SECRET.
JWT_SECRET=

JWT_EXPIRACION_MINUTOS=60
JWT_TIMEOUT_INACTIVIDAD_MINUTOS=30

CORS_ORIGINS=http://localhost:8080
